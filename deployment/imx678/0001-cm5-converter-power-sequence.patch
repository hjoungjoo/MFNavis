 };
 
+static void imx678_shutdown(struct i2c_client *client)
+{
+	struct imx678 *imx678 = to_imx678(i2c_get_clientdata(client));
+
+	if (!imx678->bus_pinctrl)
+		return;
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		/* Stop the sensor before the I2C bus is clamped for power-down. */
+		cci_write(imx678->cci, IMX678_REG_XMSTA, 0x01, NULL);
+		cci_write(imx678->cci, IMX678_REG_MODE_SELECT,
+			  IMX678_MODE_STANDBY, NULL);
+		imx678_converter_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+}
