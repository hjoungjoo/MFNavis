+static void imx678_put_bus_pinctrl(void *data)
+{
+	pinctrl_put(data);
+}
+
+static int imx678_converter_init(struct i2c_client *client,
+				   struct imx678 *imx678)
+{
+	struct device *dev = &client->dev;
+	int ret;
+
+	if (!device_is_compatible(dev, "mfnavis,imx678-cm5-converter"))
+		return 0;
+
+	if (!imx678->reset_gpio)
+		return dev_err_probe(dev, -EINVAL, "converter needs reset GPIO\n");
+
+	/* Reuse the controller's handle: sensor pinctrl would conflict with it. */
+	imx678->bus_pinctrl = pinctrl_get(client->adapter->dev.parent);
+	if (IS_ERR(imx678->bus_pinctrl))
+		return dev_err_probe(dev, PTR_ERR(imx678->bus_pinctrl),
+				     "failed to get converter bus pinctrl\n");
+	ret = devm_add_action_or_reset(dev, imx678_put_bus_pinctrl,
+				      imx678->bus_pinctrl);
+	if (ret)
+		return ret;
+	imx678->bus_active = pinctrl_lookup_state(imx678->bus_pinctrl, "default");
+	if (IS_ERR(imx678->bus_active))
+		return dev_err_probe(dev, PTR_ERR(imx678->bus_active),
+				     "missing active I2C state\n");
+	imx678->bus_off = pinctrl_lookup_state(imx678->bus_pinctrl, "imx678-off");
+	if (IS_ERR(imx678->bus_off))
+		return dev_err_probe(dev, PTR_ERR(imx678->bus_off),
+				     "missing converter shutdown I2C state\n");
+	return 0;
+}
+
+static int imx678_converter_power_off(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct imx678 *imx678 = to_imx678(i2c_get_clientdata(client));
+	int ret;
+
+	i2c_lock_bus(client->adapter, I2C_LOCK_ROOT_ADAPTER);
+	ret = pinctrl_select_state(imx678->bus_pinctrl, imx678->bus_off);
+	if (ret) {
+		dev_err(dev, "cannot clamp I2C; keeping converter powered: %d\n", ret);
+		goto unlock;
+	}
+	gpiod_set_value_cansleep(imx678->reset_gpio, 1);
+	fsleep(1000); /* XCLR / oscillator LOW before sequencer disable. */
+	clk_disable_unprepare(imx678->xclk);
+	ret = regulator_bulk_disable(ARRAY_SIZE(imx678_supply_name),
+				     imx678->supplies);
+	fsleep(150000); /* All three rails finish discharging; keep I2C LOW. */
+unlock:
+	i2c_unlock_bus(client->adapter, I2C_LOCK_ROOT_ADAPTER);
+	return ret;
+}
+
+static int imx678_converter_power_on(struct device *dev)
+{
+	struct i2c_client *client = to_i2c_client(dev);
+	struct imx678 *imx678 = to_imx678(i2c_get_clientdata(client));
+	int ret;
+
+	i2c_lock_bus(client->adapter, I2C_LOCK_ROOT_ADAPTER);
+	ret = pinctrl_select_state(imx678->bus_pinctrl, imx678->bus_off);
+	if (ret)
+		goto unlock;
+	gpiod_set_value_cansleep(imx678->reset_gpio, 1);
+	ret = regulator_bulk_enable(ARRAY_SIZE(imx678_supply_name),
+				    imx678->supplies);
+	if (ret)
+		goto unlock;
+	/* cam0_reg startup-delay-us waits 150ms after GPIO34 HIGH. */
+	gpiod_set_value_cansleep(imx678->reset_gpio, 0);
+	ret = clk_prepare_enable(imx678->xclk);
+	if (ret)
+		goto reset;
+	fsleep(5000); /* U10 oscillator startup is up to 3ms. */
+	ret = pinctrl_select_state(imx678->bus_pinctrl, imx678->bus_active);
+	if (ret) {
+		/* A failed mux change may be partial: re-clamp before cutting power. */
+		i2c_unlock_bus(client->adapter, I2C_LOCK_ROOT_ADAPTER);
+		imx678_converter_power_off(dev);
+		return ret;
+	}
+	i2c_unlock_bus(client->adapter, I2C_LOCK_ROOT_ADAPTER);
+
+	ret = imx678_write_common(imx678);
+	if (ret)
+		imx678_converter_power_off(dev);
+	return ret;
+
+reset:
+	gpiod_set_value_cansleep(imx678->reset_gpio, 1);
+	fsleep(1000);
+	regulator_bulk_disable(ARRAY_SIZE(imx678_supply_name), imx678->supplies);
+	fsleep(150000);
+unlock:
+	i2c_unlock_bus(client->adapter, I2C_LOCK_ROOT_ADAPTER);
+	return ret;
+}
+
 static int imx678_power_on(struct device *dev)
 {
 	struct i2c_client *client = to_i2c_client(dev);
