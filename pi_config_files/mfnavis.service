[Unit]
Description=MFNavis
After=basic.target

[Service]
Type=idle
User=__PIFINDER_USER__
WorkingDirectory=__PIFINDER_REPO_DIR__/python
Environment=MFNAVIS_DATA_DIR=__PIFINDER_DATA_DIR__
Environment=MFNAVIS_RUNTIME_DIR=/dev/shm/mfnavis
ExecStart=/usr/bin/python -m MFNavis.main
AmbientCapabilities=CAP_NET_BIND_SERVICE

[Install]
Alias=pifinder.service
WantedBy=basic.target
