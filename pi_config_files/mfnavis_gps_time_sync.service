[Unit]
Description=MFNavis Optional Time Sync Helper
After=basic.target mfnavis.service

[Service]
Type=simple
User=root
WorkingDirectory=__MFNAVIS_REPO_DIR__/python
Environment=MFNAVIS_DATA_DIR=__MFNAVIS_DATA_DIR__
Environment=MFNAVIS_RUNTIME_DIR=/dev/shm/mfnavis
ExecStart=/usr/bin/python -m MFNavis.gps_time_sync_helper
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
