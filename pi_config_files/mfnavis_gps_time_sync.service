[Unit]
Description=MFNavis Optional Time Sync Helper
After=basic.target mfnavis.service

[Service]
Type=simple
User=root
WorkingDirectory=__PIFINDER_REPO_DIR__/python
Environment=PIFINDER_DATA_DIR=__PIFINDER_DATA_DIR__
ExecStart=/usr/bin/python -m PiFinder.gps_time_sync_helper
Restart=on-failure
RestartSec=5

[Install]
Alias=pifinder_gps_time_sync.service
WantedBy=multi-user.target
