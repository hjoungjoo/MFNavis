#: PiFinder/ui/sqm.py:472
msgid "Inner-City Sky"
msgstr "Ciel du Centre-Ville"

#: PiFinder/ui/sqm.py:476
msgid "The sky is brilliantly lit."
msgstr "Le ciel est brillamment éclairé."

#: PiFinder/ui/sqm.py:477
msgid "Many stars forming constellations invisible."
msgstr "Nombreuses étoiles formant les constellations sont invisibles."

#: PiFinder/ui/sqm.py:478
