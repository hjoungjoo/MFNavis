#: PiFinder/ui/sqm.py:352
msgid ""
"The Scorpius and Sagittarius regions of the Milky Way cast obvious "
"shadows."
msgstr ""
"Les régions du Scorpion et du Sagittaire de la Voie Lactée projettent des"
" ombres visibles."

#: PiFinder/ui/sqm.py:355
msgid "M33 is a direct naked-eye object. Airglow readily visible."
msgstr "M33 est visible à l'œil nu. Airglow bien visible."

#: PiFinder/ui/sqm.py:356
msgid "Abundant stars make faint constellations hard to distinguish."
msgstr ""
"L'abondance d'étoiles rend les constellations faibles difficiles à "
