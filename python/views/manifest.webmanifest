    {
      "src": "/images/mfnavis-logo.png",
      "sizes": "1254x1254",
      "type": "image/png",
      "purpose": "any"
    }
  ],
  "shortcuts": [
    {
      "name": "Remote",
      "short_name": "Remote",
      "url": "/remote"
    },
    {
      "name": "Logs",
      "short_name": "Logs",
      "url": "/logs"
    }
  ]
}
