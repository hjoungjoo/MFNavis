{
  "name": "MFNavis",
  "short_name": "MFNavis",
  "description": "MFNavis web control interface",
  "start_url": "/",
  "scope": "/",
  "display": "fullscreen",
  "display_override": [
    "fullscreen",
    "standalone",
    "minimal-ui"
  ],
  "background_color": "#080000",
  "theme_color": "#260303",
